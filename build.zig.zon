.{
    .name = .wasapi,
    .version = "0.2.0",
    .fingerprint = 0x2879cc4873338f63, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Generated Zig bindings for the Win32 API, which is every system call
        // this library makes. A tarball rather than `git+https`: the repository
        // is around 99 MB of history where a tarball of one commit is 7 MB.
        //
        // Lazy, so that `zig build docs` and a consumer that only wants the
        // documentation need not fetch it. Anything that compiles the library
        // does, which -- this being a Windows-only library -- is everything
        // else, including `zig build check`.
        .win32 = .{
            .url = "https://github.com/marlersoft/zigwin32/archive/fb2645891520f3e99931db17a7eba04057e87e89.tar.gz",
            .hash = "win32-42.0.39-preview-mX5pFc794wMcrMyFgsO1c4csBdowhpiqqwIyN_xjqI5z",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "tests",
        "tools",
        "LICENSES",
        "REUSE.toml",
        "README.md",
    },
}
